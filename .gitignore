# ---------- Environment & Secrets ----------
.env
.env.local
.env.production
.env.*.local
*.pem
*.key

# ---------- Go Backend ----------
backend/hardsend
backend/hardsend.exe
backend/hardsend_metrics.db
backend/hardsend_metrics.db-wal
backend/hardsend_metrics.db-shm
backend/tmp/
backend/static/

# ---------- Frontend ----------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---------- OS Files ----------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---------- IDE / Editor ----------
.vscode/settings.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Test artifacts ----------
test_data/*.pdf

# ---------- Build artifacts ----------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
